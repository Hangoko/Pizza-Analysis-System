# Docker Compose / PostgreSQL
POSTGRES_DB=pizza
POSTGRES_USER=pizza
POSTGRES_PASSWORD=change-me-database-password

# Published ports
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8000
FRONTEND_BIND_ADDRESS=0.0.0.0
FRONTEND_PORT=8080

# Backend security
JWT_SECRET_KEY=change-me-to-a-long-random-secret
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_PASSWORD=change-me-admin-password
FIRST_ADMIN_EMAIL=
ALLOW_PUBLIC_REGISTRATION=false
CORS_ORIGINS=http://localhost:8080
RUN_SEED=true

# The test deployment starts without the large road graph. Upload it through
# /api/v1/admin/graph/upload or mount data/nn_graph.pkl before enabling startup loading.
LOAD_GRAPH_ON_STARTUP=false
GRAPH_DOWNLOAD_IF_MISSING=false

